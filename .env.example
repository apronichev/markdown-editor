# Copy to .env for local development, or set these as Vercel project environment
# variables. Never commit real values.

# From your GitHub OAuth app (Settings → Developer settings → OAuth Apps).
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Encrypts the session cookie. Must be at least 32 characters and kept secret.
# Generate one with:  openssl rand -base64 48
SESSION_SECRET=

# Optional. Pin the public origin used to build OAuth redirect URLs. Leave unset
# to derive it from the request, which is usually right on Vercel. Set it when
# you use a custom domain so preview URLs cannot alter the redirect.
# APP_BASE_URL=https://your-app.vercel.app

# Optional. Defaults to "repo read:user", the narrowest scope that can read and
# push to private repositories. Use "public_repo read:user" for public-only.
# GITHUB_OAUTH_SCOPES=repo read:user

# Optional. Point at a GitHub Enterprise Server REST API instead of github.com.
# GITHUB_API_BASE_URL=https://github.example.com/api/v3
